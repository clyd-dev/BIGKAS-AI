APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

# Comma-separated proxy IPs/CIDRs (or * for all) trusted for X-Forwarded-Proto.
# Required in production behind a TLS-terminating proxy (nginx, Cloudflare)
# so HTTPS enforcement sees the real scheme. Leave empty for direct serving.
# WARNING: '*' must only be used behind a filtered load balancer/CDN —
# any client can otherwise spoof X-Forwarded-Proto and bypass HTTPS
# enforcement. Prefer explicit proxy IPs/CIDRs.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Leave UNSET: the cookie is then Secure on HTTPS and plain over HTTP, so the
# same .env works on an IP without a certificate and behind one later. Setting
# true while the site is served over HTTP makes the browser discard the cookie
# — every login and logout then fails with "419 Page Expired".
# SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
# Gmail SMTP needs an App Password (Google Account → Security → 2-Step
# Verification → App passwords). A regular Gmail password will NOT work.
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Machine-learning microservice (Flask) + speech-to-text mode.
# Model-less launch: ML_API_ENABLED=false (rule-based fallback, no Flask needed).
# With local Whisper: ML_API_ENABLED=true, WHISPER_USE_LOCAL=true.
# OpenAI cloud STT instead: WHISPER_USE_LOCAL=false + OPENAI_API_KEY.
ML_API_URL=http://127.0.0.1:5000
ML_API_ENABLED=false
WHISPER_USE_LOCAL=true
OPENAI_API_KEY=

# Seconds to wait for local CPU transcription. The recorder stops at 3 minutes
# of audio and faster-whisper 'small' runs slower than real time on a small
# VPS, so this needs minutes. Keep it BELOW php-fpm request_terminate_timeout
# and nginx fastcgi_read_timeout (both 360s+ in docs/deployment-vps.md), and
# BELOW gunicorn's --timeout, so this limit is the one that fires first.
WHISPER_TIMEOUT=300

# The placeholder transcript ("I have a dog his name is Max...") is a dev aid.
# Scoring it stores an assessment that measured nothing, so it is refused
# unless allowed here. Unset = local/testing only. Set true ONLY for a demo
# with no speech engine; never on a server teachers use for real assessments.
STT_ALLOW_MOCK=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
